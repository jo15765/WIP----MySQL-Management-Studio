<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MySqlManagementStudio.ViewModels"
        x:Class="MySqlManagementStudio.Views.ConnectionDialog"
        x:DataType="vm:ConnectionDialogViewModel"
        Title="Connect to MySQL Server"
        Icon="/Assets/mysql-management-studio.ico"
        Width="560"
        MinWidth="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Window.Styles>
        <Style Selector="Button.dialog">
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#6B6B6B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BoxShadow="0 3 8 0 #55000000">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.dialog:pointerover /template/ Border">
            <Setter Property="Background" Value="#F3F8FD" />
            <Setter Property="BorderBrush" Value="#0078D4" />
            <Setter Property="BoxShadow" Value="0 4 10 0 #660078D4" />
        </Style>
        <Style Selector="Button.dialog:pressed /template/ Border">
            <Setter Property="Background" Value="#E7F1FB" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #40000000" />
        </Style>
        <Style Selector="Button.dialog.primary">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#005A9E" />
        </Style>
        <Style Selector="Button.dialog.primary:pointerover /template/ Border">
            <Setter Property="Background" Value="#1684D8" />
            <Setter Property="BorderBrush" Value="#005A9E" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #800078D4" />
        </Style>
        <Style Selector="Button.dialog.primary:pressed /template/ Border">
            <Setter Property="Background" Value="#006CBD" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #500078D4" />
        </Style>
        <Style Selector="Button.dialog:disabled /template/ Border">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="BoxShadow" Value="0 1 2 0 #30000000" />
        </Style>
    </Window.Styles>

    <Border Padding="20">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,20,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           MinHeight="24"
                           Opacity="0.9" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="12"
                            Margin="0,4,0,2">
                    <Button Classes="dialog"
                            Content="Test Connection"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                    <Button Classes="dialog primary"
                            Content="Connect"
                            IsDefault="True"
                            Click="OnConnectClick" />
                    <Button Classes="dialog"
                            Content="Cancel"
                            IsCancel="True"
                            Click="OnCancelClick" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                    <Image Source="/Assets/mysql-management-studio.png"
                           Width="96"
                           Height="64"
                           Stretch="Uniform"
                           VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="MySQL Management Studio"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                        <TextBlock Text="Enter MySQL connection details."
                                   Opacity="0.75"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Connection name" FontWeight="SemiBold" />
                <TextBox Text="{Binding Name}"
                         PlaceholderText="My production MySQL"
                         HorizontalAlignment="Stretch" />

                <Grid ColumnDefinitions="*,120"
                      ColumnSpacing="12"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Server host" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Port" FontWeight="SemiBold" />

                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding Host}"
                             PlaceholderText="localhost"
                             HorizontalAlignment="Stretch" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding PortText}"
                             PlaceholderText="3306"
                             HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="Authentication"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Login" Opacity="0.8" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Password" Opacity="0.8" />

                    <TextBox Grid.Row="4" Grid.Column="0"
                             Text="{Binding Username}"
                             PlaceholderText="root"
                             HorizontalAlignment="Stretch" />
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding Password}"
                             PasswordChar="•"
                             PlaceholderText="Password"
                             HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="Default database (optional)"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0" />

                    <TextBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                             Text="{Binding DefaultDatabase}"
                             PlaceholderText="Leave blank to show all databases"
                             HorizontalAlignment="Stretch" />

                    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Spacing="20"
                                Margin="0,4,0,0">
                        <CheckBox Content="Remember password" IsChecked="{Binding SavePassword}" />
                        <CheckBox Content="Require SSL" IsChecked="{Binding UseSsl}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
